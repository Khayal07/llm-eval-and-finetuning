# OpenAI API key - NEVER commit the real key. Copy this file to `.env` and fill it.
OPENAI_API_KEY=sk-your-key-here

# Model under evaluation (agent_or_rag.py answer generator).
EVAL_MODEL=gpt-4o-mini

# Judge model used for LLM-as-a-Judge scoring (checkpoint 2+).
JUDGE_MODEL=gpt-4o

# Judge sampling temperature; keep low for stable, reproducible verdicts.
JUDGE_TEMPERATURE=0.0

# Retriever no-evidence cosine gate (checkpoint 4): when the best-matching
# document's IDF-weighted cosine similarity falls below this value the query is
# treated as out-of-scope and the safe "cannot find" fallback is returned.
RETRIEVER_MIN_SIMILARITY=0.12

# Optional fine-tuned model id created by optimize.py (checkpoint 5).
# Leave empty to keep fine-tuning disabled.
FINE_TUNE_MODEL=

# Token pricing in USD per 1M tokens used to estimate cost (overrides defaults).
# Defaults live in evals/metrics.py (DEFAULT_PRICING).
# PRICING_INPUT_PER_1M=0.15
# PRICING_OUTPUT_PER_1M=0.60